# T1082 - System Information Discovery
# Atomic Red Team: T1082-1
# Purpose: Investigation queries used during the lab

# 1. Find Sysmon Process Creation events generated by the test
index=* host="Windows_for_soc" EventCode=1
User="Windows_for_soc\\Abhishek"
| table _time Image ProcessId ParentImage ParentProcessId CommandLine
| sort -_time


# 2. Find child processes created by the PowerShell process
# Parent PowerShell PID identified during investigation: 9824
index=* host="Windows_for_soc" EventCode=1
User="Windows_for_soc\\Abhishek"
ParentProcessId=9824
| table _time Image ProcessId ParentImage ParentProcessId CommandLine
| sort -_time


# 3. Investigate the identified cmd.exe process
# PID: 11656
index=* host="Windows_for_soc" EventCode=1
ProcessId=11656
| table _time Image ProcessId ParentImage ParentProcessId CommandLine ProcessGuid ParentProcessGuid


# 4. Find child processes of cmd.exe
index=* host="Windows_for_soc" EventCode=1
ParentProcessId=11656
| table _time Image ProcessId ParentImage ParentProcessId CommandLine ProcessGuid ParentProcessGuid
| sort _time
